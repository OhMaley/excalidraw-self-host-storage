# =============================================================================
# Production environment template
# =============================================================================
# Copy to the server's deploy directory as .env.prod and fill in real values
# (see docker/DEPLOY.md):
#   cp env.prod.template <deploy-dir>/.env.prod
#   chmod 600 <deploy-dir>/.env.prod
#
# Used by deploy.sh with:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod --env-file .env.version ...
# APP_VERSION (the image tag) lives in .env.version, written by deploy.sh —
# don't set it here.
#
# Keycloak is NOT deployed by this compose file. It assumes Keycloak already
# runs in production elsewhere, with its own database and nginx vhost. A realm
# and client for this app must be created manually in that Keycloak's admin
# console before the backend can start (its JWKS prefetch on startup will fail
# if the realm doesn't exist yet).

# Fixed Compose project name: volume names (<project>_appdb_data,
# <project>_drawings_data) depend on it. If you already ran the old
# build-on-server setup from the repo's docker/ dir, your volumes are named
# docker_*: set this to `docker` to keep using them.
COMPOSE_PROJECT_NAME=excalidraw

# =============================================================================
# Application database
# =============================================================================

# Database credentials (required) — not published to the host, internal network only.
APP_DB_USER=change_me
APP_DB_PASSWORD=change_me
APP_DB_NAME=excalidraw

POSTGRES_VERSION=15

# =============================================================================
# Backend
# =============================================================================

PORT=3000

# Issuer/JWKS point at your production Keycloak's public URL.
# Replace <realm> with the realm created for this app.
KEYCLOAK_ISSUER=https://auth.yourdomain.example/realms/<realm>
KEYCLOAK_JWKS_URL=https://auth.yourdomain.example/realms/<realm>/protocol/openid-connect/certs

# Expected `aud` claim in JWTs issued by Keycloak for this app's client.
# Required in production (unlike local dev, where it's optional).
KEYCLOAK_AUDIENCE=change_me

# Leave empty — frontend and backend share an origin via the host's reverse
# proxy path routing in production (/api/* -> backend, /* -> frontend), so no
# cross-origin requests occur and CORS is unnecessary. Only set this if
# the frontend is ever served from a different origin than the backend.
CORS_ALLOWED_ORIGINS=

RUST_LOG=info

# =============================================================================
# Frontend (runtime config — written to the public /config.js at container
# start, so only put public values here; changes apply on `up -d`)
# =============================================================================

# Relative path; the host's reverse proxy strips the /api prefix before
# proxying to backend.
FRONTEND_API_BASE=/api
FRONTEND_KEYCLOAK_URL=https://auth.yourdomain.example
FRONTEND_KEYCLOAK_REALM=change_me
FRONTEND_KEYCLOAK_CLIENT_ID=change_me

# =============================================================================
# Images
# =============================================================================

# Registry/namespace the images are pulled from (lowercase).
IMAGE_PREFIX=ghcr.io/ohmaley/excalidraw-self-host-storage

# Host-side loopback port that the reverse proxy forwards `/` to
# (see docker/reverse-proxy/excalidraw.conf.example).
FRONTEND_HOST_PORT=8081
