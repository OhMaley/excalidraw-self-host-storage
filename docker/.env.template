# =============================================================================
# Keycloak
# =============================================================================

# Image
KEYCLOAK_VERSION=latest

# Admin credentials (required)
KEYCLOAK_ADMIN=change_me
KEYCLOAK_ADMIN_PASSWORD=change_me

# Database credentials (required)
KC_DB_USERNAME=change_me
KC_DB_PASSWORD=change_me

# Database config
KC_DB_NAME=keycloak
KC_DB_HOST=keycloakdb
KC_DB_PORT=5432

# Networking
KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=8080
KC_HOST_PORT=8080
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false

# Features
KC_LOG_LEVEL=info
KC_METRICS_ENABLED=true
KC_HEALTH_ENABLED=true

# =============================================================================
# Application
# =============================================================================

# Database credentials (required)
APP_DB_USER=change_me
APP_DB_PASSWORD=change_me

# Database config
APP_DB_NAME=excalidraw
APP_DB_HOST_PORT=5432

# Backend
# KEYCLOAK_ISSUER must match the `iss` claim in Keycloak JWTs — use KC_HOSTNAME:KC_HOSTNAME_PORT (the public URL)
# KEYCLOAK_JWKS_URL uses the Docker-internal hostname so the backend container can reach Keycloak
PORT=3000
DATABASE_URL=postgres://change_me:change_me@appdb:5432/excalidraw
KEYCLOAK_ISSUER=http://change_me:8080/realms/change_me
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/change_me/protocol/openid-connect/certs
CORS_ALLOWED_ORIGINS=change_me

# Host path for local drawing storage (bind-mounted to /storage/drawings in the container)
DRAWINGS_PATH=./.storage/drawings

# Shared
POSTGRES_VERSION=15
