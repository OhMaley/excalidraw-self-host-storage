{
    "name": "excalidraw-self-host-storage",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --mode development",
        "build": "tsc -b && vite build --mode production",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "preview": "vite preview --port 5173",
        "openapi:lint": "redocly lint ../openapi/openapi.yaml --config ../redocly.yaml",
        "openapi:bundle": "redocly bundle ../openapi/openapi.yaml -o ../github-pages/openapi.yaml",
        "type-check": "tsc -p tsconfig.app.json",
        "jscpd": "jscpd",
        "knip": "knip",
        "audit": "npm audit --audit-level=moderate",
        "check-updates": "npx --yes npm-check-updates"
    },
    "dependencies": {
        "@excalidraw/excalidraw": "^0.18.1",
        "keycloak-js": "^26.2.4",
        "radix-ui": "^1.6.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router-dom": "^7.18.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@redocly/cli": "^2.34.0",
        "@types/node": "^26.0.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "esbuild": "^0.28.1",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "eslint-plugin-sonarjs": "^4.1.0",
        "globals": "^17.6.0",
        "jscpd": "^5.0.11",
        "knip": "^6.18.0",
        "prettier": "^3.8.4",
        "sass": "^1.101.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.61.1",
        "vite": "^8.0.16",
        "vite-plugin-svgr": "^5.2.0"
    },
    "overrides": {
        "lodash-es": "^4.18.1",
        "@excalidraw/excalidraw": {
            "nanoid": "^3.3.8"
        },
        "@excalidraw/mermaid-to-excalidraw": {
            "nanoid": "^5.1.11"
        },
        "@opentelemetry/core": "^2.8.0",
        "js-yaml": "^4.2.0"
    }
}
