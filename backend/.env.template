# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string.
DATABASE_URL=postgres://user:password@localhost:5432/excalidraw

# ── sqlx ──────────────────────────────────────────────────────────────────────
# Set to true to compile using the cached query metadata in .sqlx/ instead of
# connecting to a live database. Required when building without a database
# available (CI, Docker builds). Leave unset during active development so sqlx
# validates queries against the live schema.
# Run `cargo sqlx prepare` to refresh the cache after changing any query.
SQLX_OFFLINE=false

# ── Keycloak / JWT ────────────────────────────────────────────────────────────
# Issuer URL of the Keycloak realm (value of the `iss` claim in tokens).
# Example: https://auth.example.com/realms/myrealm
KEYCLOAK_ISSUER=http://localhost:8080/realms/myrealm

# JWKS endpoint used to fetch RS256 public keys for token verification.
# Example: https://auth.example.com/realms/myrealm/protocol/openid-connect/certs
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/myrealm/protocol/openid-connect/certs

# (Optional) Expected value of the `aud` claim in JWT tokens.
# When set, tokens whose audience does not include this value are rejected.
# Recommended for production to prevent tokens minted for other Keycloak clients
# from being accepted by this backend.
# Example: excalidraw-backend
KEYCLOAK_AUDIENCE=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins that may send cross-origin requests.
# Leave empty (default) to deny all cross-origin requests — safe when the
# frontend and backend share an origin or sit behind a single reverse proxy.
# Use * to allow any origin (development only).
# Example: https://app.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=

# ── Server ────────────────────────────────────────────────────────────────────
# HTTP port the backend listens on.
PORT=3000

# ── Storage ───────────────────────────────────────────────────────────────────
# Filesystem path where drawing JSON files and thumbnails are stored.
STORAGE_LOCAL_PATH=./drawings

# ── Logging ───────────────────────────────────────────────────────────────────
# tracing-subscriber log filter. Accepts a comma-separated list of directives.
# Examples: info  |  debug  |  info,excalidraw_storage_backend=debug
RUST_LOG=info