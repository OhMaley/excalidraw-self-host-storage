  "query": "SELECT\n            u.id   AS \"user_id!\",\n            u.name AS \"user_name!\",\n            wm.role AS \"role: WorkspaceRole\",\n            wm.joined_at\n        FROM workspace_members wm\n        JOIN users u ON u.id = wm.user_id\n        WHERE wm.workspace_id = $1\n        ORDER BY wm.joined_at",
